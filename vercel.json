{
  "installCommand": "pnpm install",
  "buildCommand": "pnpm build",
  "functions": {
    "app/api/auditor/continue/route.ts": {
      "memory": 1024,
      "maxDuration": 60
    },
    "app/api/auditor/billing/cardcom/indicator/route.ts": {
      "maxDuration": 30
    },
    "app/api/auditor/billing/process-pending/route.ts": {
      "maxDuration": 250
    }
  },
  "crons": [
    {
      "path": "/api/auditor/billing/process-pending",
      "schedule": "* * * * *"
    }
  ]
}
